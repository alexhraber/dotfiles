#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"
shellcheck install.sh scripts/dotfiles scripts/check
for source in .zshrc .zprofile .config/zsh/env.zsh .config/zsh/projects.zsh .config/zsh/local-models.zsh .config/zsh/workspaces.zsh; do
  zsh -n "$source"
done
python_bin=python3
if command -v python3.14 >/dev/null 2>&1; then python_bin=python3.14; fi
"$python_bin" -m unittest discover -s tests -v
