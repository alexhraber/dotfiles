#!/usr/bin/env bash
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
config_dir="${CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/sketchybar}"
plugin="$config_dir/plugins/status.sh"
eval "$(python3 -B "$config_dir/plugins/appearance.py" shell)"

sketchybar --bar position=top height=34 notch_display_height=40 margin=12 y_offset=4 \
  corner_radius=0 border_width=0 \
  color=0x00000000 blur_radius=0 padding_left=6 padding_right=6 \
  topmost=on shadow=off show_in_fullscreen=on hidden=on
sketchybar --default icon.font='JetBrainsMono Nerd Font:Regular:15.0' icon.width=18 icon.align=center \
  label.font='SF Pro:Medium:11.5' \
  icon.color="$UI_MUTED" label.color="$UI_FOREGROUND" \
  padding_left=6 padding_right=6 label.padding_left=3 label.padding_right=3 \
  background.corner_radius=8 background.height=26

sketchybar --add event desktop_revealed
sketchybar --add event desktop_concealed
sketchybar --add event desktop_access_check
sketchybar --add item apple left --set apple icon='' icon.font='SF Pro:Medium:19.0' label.drawing=off \
  icon.color="$UI_ACCENT" script="\"$plugin\"" --subscribe apple mouse.entered mouse.clicked
sketchybar --add item front_app left --set front_app icon='' icon.width=22 \
  icon.background.image.scale=0.3 label='Workstation' label.max_chars=18 label.font='SF Pro:Semibold:12.0' script="\"$plugin\"" \
  --subscribe front_app front_app_switched
for menu in {0..11}; do
  sketchybar --add item "app_menu.$menu" left --set "app_menu.$menu" drawing=off icon.drawing=off \
    label.font='SF Pro:Medium:12.0' label.max_chars=16 padding_left=4 padding_right=4 \
    script="\"$plugin\"" --subscribe "app_menu.$menu" mouse.entered mouse.clicked
done
sketchybar --add item clock right --set clock icon.drawing=off label.width=74 label.align=center update_freq=1 updates=on \
  label.color="$UI_SECONDARY" script="\"$plugin\"" --subscribe clock desktop_revealed system_woke
sketchybar --add item weather right --set weather icon='󰖙' label='—' label.width=43 label.align=right script="\"$plugin\"" \
  update_freq=900 updates=when_shown --subscribe weather desktop_revealed system_woke
sketchybar --add item battery right --set battery icon='󰁹' label.width=34 label.align=right update_freq=60 \
  label.color="$UI_SUCCESS" script="\"$plugin\"" \
  --subscribe battery power_source_change system_woke desktop_revealed
sketchybar --add item volume right --set volume icon='󰕾' label.drawing=off script="\"$plugin\"" \
  --subscribe volume volume_change desktop_revealed
sketchybar --add item brightness right --set brightness icon='󰃠' label.drawing=off script="\"$plugin\""
sketchybar --add item wifi right --set wifi icon='󰖩' label='' script="\"$plugin\"" \
  update_freq=60 --subscribe wifi desktop_revealed system_woke
sketchybar --add item bluetooth right --set bluetooth icon='󰂯' label='' script="\"$plugin\"" \
  update_freq=60 --subscribe bluetooth desktop_revealed system_woke
sketchybar --add item alerts right --set alerts icon='󰂚' label='' script="\"$plugin\""
for sensor in memory gpu cpu; do
  case "$sensor" in
    cpu) glyph='󰻠' ;;
    gpu) glyph='󰢮' ;;
    memory) glyph='󰍛' ;;
  esac
  sketchybar --add item "$sensor" right --set "$sensor" icon="$glyph" \
    label.color="$UI_MUTED" label.font='SF Pro:Medium:11.5' label.width=44 label.align=right \
    label='—' script="\"$plugin\""
done
sketchybar --set cpu update_freq=5 \
  updates=when_shown --subscribe cpu desktop_revealed system_woke
for parent in clock weather volume brightness wifi bluetooth alerts battery cpu gpu memory; do
  sketchybar --subscribe "$parent" mouse.entered mouse.exited mouse.clicked
done
for control in volume brightness; do
  sketchybar --subscribe "$control" mouse.scrolled
done
sketchybar --move alerts before clock
for boundary in hardware session chronicle notifications; do
  sketchybar --add item "gap_$boundary" right --set "gap_$boundary" width=8 \
    icon.drawing=off label.drawing=off background.drawing=off padding_left=0 padding_right=0
done
sketchybar --move gap_hardware before memory \
  --move gap_session before volume --move gap_chronicle before battery --move gap_notifications before clock
sketchybar --add item hover_guard left --set hover_guard drawing=off script="\"$plugin\"" \
  --subscribe hover_guard desktop_revealed desktop_concealed
sketchybar --add item access_check left --set access_check drawing=off \
  script="python3 -B \"$config_dir/plugins/controls.py\" access probe" \
  --subscribe access_check desktop_access_check
sketchybar --add bracket context apple front_app '/app_menu\..*/'
sketchybar --add bracket chronicle clock weather
sketchybar --add bracket ribbon cpu gpu memory bluetooth wifi brightness volume battery weather clock alerts \
  --add bracket hardware cpu gpu memory \
    --add bracket connections bluetooth wifi brightness volume \
    --add bracket session battery \
    --add bracket notifications alerts
for group in context chronicle ribbon hardware connections session notifications; do
  sketchybar --set "$group" background.drawing=on background.height=30 \
    background.corner_radius=10 background.color="$UI_GLASS" \
    background.border_color="$UI_BORDER" background.border_width=1 \
    background.padding_left=0 background.padding_right=0
done
sketchybar --set cpu padding_left=12 --set memory padding_right=12 \
  --set alerts padding_left=10 padding_right=12 icon.color="$UI_ACCENT" \
  --set bluetooth padding_left=10 --set volume padding_right=10 \
  --set battery padding_left=10 padding_right=10 --set clock padding_left=10 \
  --set weather padding_right=10 \
  --set apple padding_left=12 --set front_app padding_right=8
python3 -B "$config_dir/plugins/appearance.py" apply
sketchybar --update
