{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue",
            "output": "white",
            "separator": "black"
        },
        "key": {
            "width": 12
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "uptime",
        "cpu",
        { "type": "gpu", "format": "{name} · {core-count} cores" },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "folders": "/"
        },
        "terminal",
        { "type": "battery", "format": "{capacity} · {status}" },
        "break",
        "colors"
    ]
}
